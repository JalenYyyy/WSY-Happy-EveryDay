{
  "name": "wsy-happy-everyday",
  "version": "1.0.0",
  "description": "A shared cat companion chat app powered by OpenAI-compatible LLMs.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "smoke:login-throttle": "tsx scripts/smoke-login-throttle.ts",
    "db:push": "prisma generate && tsx prisma/init-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma generate && tsx prisma/init-db.ts --reset && tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JalenYyyy/WSY-Happy-EveryDay.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JalenYyyy/WSY-Happy-EveryDay/issues"
  },
  "homepage": "https://github.com/JalenYyyy/WSY-Happy-EveryDay#readme",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.2",
    "@earendil-works/pi-ai": "^0.74.2",
    "@prisma/client": "^5.22.0",
    "@tavily/core": "^0.7.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.14",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
